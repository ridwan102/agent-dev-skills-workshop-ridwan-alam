# API Key Configuration Template
# Copy this file to .env and fill in your actual API keys
# The .env file is gitignored and will not be committed

# Google Cloud API Key (for Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# Google Maps API Key (for geocoding)
# Note: The notebook has fallback coordinates for common cities
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Anthropic API Key (for Claude)
# Optional - only needed if testing with Claude provider
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your actual API keys
# 3. The .env file is already in .gitignore and won't be committed
